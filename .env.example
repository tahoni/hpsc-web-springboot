# Copy to .env (gitignored) and fill in before running docker compose
MYSQL_USER=hpsc
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# Optional host ports. If a local MySQL already listens on 3306, publish the Compose MySQL on 3307 instead; the
# application still reaches it on 3306 inside the Compose network.
#APP_PORT=8080
#MYSQL_PORT=3307
